                            const newHearts = prevHearts+1;
                            return newHearts;
                        });
                        if(!hasBeenRemoved.current){
                            hasBeenRemoved.current = true;
                            assetPool.release(obj);
                        }
                    }
                }
            }
        }
        if(obj.position.z > 1.5){
            if(!hasBeenRemoved.current){
                hasBeenRemoved.current = true;
                assetPool.release(obj);
                //?obj.position.z += GAME_SPEED*delta;
            }
